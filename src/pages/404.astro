---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE } from "@consts";
---

<Layout title="404 Not Found" description={SITE.DESCRIPTION}>
  <Container>
    <div class="retro-bevel bg-[#ece9d8] dark:bg-[#1a2336] p-2 max-w-2xl mx-auto my-6 font-retro">
      <!-- Error Dialog Titlebar -->
      <div class="retro-titlebar px-2.5 py-1 text-xs sm:text-sm font-bold flex items-center justify-between select-none">
        <div class="flex items-center gap-2">
          <span>⚠️</span>
          <span>HTTP 404 - FILE NOT FOUND</span>
        </div>
        <div class="flex items-center gap-1">
          <span class="retro-win-ctrl-btn">✕</span>
        </div>
      </div>

      <!-- Error Content Surface -->
      <div class="p-4 sm:p-6 bg-white dark:bg-[#090d16] retro-bevel-inset m-1.5 space-y-4 text-xs sm:text-sm leading-relaxed text-neutral-800 dark:text-neutral-200">
        <div class="flex items-start gap-4">
          <div class="text-4xl select-none shrink-0">🌐💥</div>
          <div>
            <h1 class="text-lg sm:text-xl font-bold text-[#0a246a] dark:text-[#38bdf8] font-heading">
              The page cannot be found
            </h1>
            <p class="text-neutral-600 dark:text-neutral-400 mt-1">
              The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
            </p>
          </div>
        </div>

        <hr class="retro-hr" />

        <div class="space-y-2">
          <p class="font-bold">Please try the following:</p>
          <ul class="list-disc pl-5 space-y-1 text-neutral-700 dark:text-neutral-300">
            <li>If you typed the page address in the Address bar, make sure that it is spelled correctly.</li>
            <li>Click the <strong>Home</strong> button below to return to the main directory.</li>
            <li>Use the <strong>Find (Search)</strong> tool above to search for topics or posts.</li>
          </ul>
        </div>

        <div class="pt-2 flex items-center justify-between border-t border-neutral-200 dark:border-neutral-800">
          <span class="font-mono text-xs text-neutral-500">
            HTTP 404 - File Not Found &bull; Internet Explorer 5.5
          </span>
          <a href="/" class="retro-btn text-xs font-bold py-1 px-4">
            <span>🏠 Return Home</span>
          </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>
