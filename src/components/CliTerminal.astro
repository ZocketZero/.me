|  \\| |  _  | | | |  _  |   __|  _  |   | |
|     |     | | | |     |__   |     | | | |
|_|\\__|__|__|_____|__|__|_____|__|__|_|___|
</span>`;

      printLine(asciiBanner);
      printLine(
        `<div class="text-[#a6caf0] dark:text-[#38bdf8] font-bold">` +
        `Nawasan's CyberHome Terminal [Version 2.0.26]<br/>` +
        `(C) Copyright Nawasan / ZocketZero. All rights reserved.` +
        `</div>`
      );
      printLine(
        `<div class="text-neutral-300 mt-1">` +
        `Welcome to the interactive site shell! Navigate, search, and inspect content.<br/>` +
        `Type <span class="cli-cmd-link text-yellow-300 font-bold underline cursor-pointer" data-cmd="help">help</span> for a list of commands, ` +
        `<span class="cli-cmd-link text-yellow-300 font-bold underline cursor-pointer" data-cmd="ls">ls</span> to list files, or ` +
        `<span class="cli-cmd-link text-yellow-300 font-bold underline cursor-pointer" data-cmd="open blog">open blog</span> to visit the blog.` +
        `</div>`
      );
      printLine(`<div class="border-b border-neutral-700 my-1"></div>`);
    }

    // Commands Implementation
    const commands = {
      help: (args) => {
        const sub = args[0]?.toLowerCase();
        if (sub && commandHelpDetails[sub]) {
          printLine(commandHelpDetails[sub]);
          return;
        }

        const helpHtml =
`<div class="space-y-2">
  <div class="text-yellow-300 font-bold border-b border-neutral-700 pb-1">AVAILABLE CLI COMMANDS:</div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-1 text-xs">
    <div>
      <span class="text-sky-400 font-bold">NAVIGATION:</span>
      <ul class="ml-2 space-y-0.5">
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="cd blog">cd &lt;dir&gt;</span> <span class="text-neutral-400">- Change folder (~, blog, projects, tags, ..)</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="pwd">pwd</span> <span class="text-neutral-400">- Print current working directory</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="open blog">open &lt;page&gt;</span> <span class="text-neutral-400">- Navigate to page/post in browser</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="back">back</span> <span class="text-neutral-400">- Go back in browser history</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="reload">reload</span> <span class="text-neutral-400">- Reload the page</span></li>
      </ul>
    </div>

    <div>
      <span class="text-sky-400 font-bold">BROWSING & CONTENT:</span>
      <ul class="ml-2 space-y-0.5">
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="ls">ls [-l] [dir]</span> <span class="text-neutral-400">- List files and directories</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="tree">tree</span> <span class="text-neutral-400">- Display directory structure</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="cat about.txt">cat &lt;file&gt;</span> <span class="text-neutral-400">- View file, article, or project info</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="search linux">search &lt;query&gt;</span> <span class="text-neutral-400">- Search posts & projects by keyword</span></li>
      </ul>
    </div>

    <div>
      <span class="text-sky-400 font-bold">SYSTEM & TOOLS:</span>
      <ul class="ml-2 space-y-0.5">
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="theme">theme [mode]</span> <span class="text-neutral-400">- Switch theme (light, dark, toggle)</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="neofetch">neofetch</span> <span class="text-neutral-400">- System info & ASCII logo</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="whoami">whoami</span> <span class="text-neutral-400">- Current user session</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="socials">socials</span> <span class="text-neutral-400">- Links to GitHub, LinkedIn, email</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="ping nawasan.dev">ping &lt;host&gt;</span> <span class="text-neutral-400">- Send ICMP packets to test latency</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="date">date</span> <span class="text-neutral-400">- Show current date and time</span></li>
      </ul>
    </div>

    <div>
      <span class="text-sky-400 font-bold">UTILITIES & FUN:</span>
      <ul class="ml-2 space-y-0.5">
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="clear">clear</span> <span class="text-neutral-400">- Clear screen (or Ctrl+L)</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="history">history</span> <span class="text-neutral-400">- View command history</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="matrix">matrix</span> <span class="text-neutral-400">- Cyber green falling rain</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="fortune">fortune</span> <span class="text-neutral-400">- Random programmer wisdom</span></li>
        <li><span class="cli-cmd-link text-emerald-400 font-semibold cursor-pointer underline" data-cmd="exit">exit</span> <span class="text-neutral-400">- Close terminal window</span></li>
      </ul>
    </div>
  </div>

  <div class="text-neutral-400 text-[11px] pt-1 border-t border-neutral-700">
    Tip: Click on any green command above or press <kbd class="px-1 py-0.2 bg-neutral-800 border border-neutral-600 text-neutral-200">Tab</kbd> to auto-complete!
  </div>
</div>`;
        printLine(helpHtml);
      },

      pwd: () => {
        const full = cwd === "~" ? "/home/nawasan" : `/home/nawasan/${cwd.replace(/^~\/?/, "")}`;
        printLine(`<span class="text-sky-300 font-mono">${escapeHtml(full)}</span>`);
      },

      cd: (args) => {
        const target = (args[0] || "~").trim();
        const shouldGo = args.includes("-g") || args.includes("--go");

        // cd ~ or cd / or cd
        if (target === "~" || target === "/" || target === "") {
          cwd = "~";
          updatePrompt();
          printLine(`<span class="text-neutral-400">Changed directory to <span class="text-sky-300">~</span></span>`);
          if (shouldGo) window.location.href = "/";
          return;
        }

        // cd ..
        if (target === ".." || target === "../") {
          if (cwd !== "~") {
            cwd = "~";
            updatePrompt();
            printLine(`<span class="text-neutral-400">Changed directory to <span class="text-sky-300">~</span></span>`);
          } else {
            printLine(`<span class="text-neutral-400">Already at root directory (~)</span>`);
          }
          return;
        }

        const normalized = target.replace(/^\/+/, "").replace(/\/+$/, "");

        // cd blog
        if (normalized === "blog") {
          cwd = "~/blog";
          updatePrompt();
          printLine(
            `<span class="text-neutral-400">Switched directory to <span class="text-sky-300">~/blog</span>. ` +
            `Type <span class="cli-cmd-link text-yellow-300 underline cursor-pointer" data-cmd="ls">ls</span> to view posts or ` +
            `<span class="cli-cmd-link text-yellow-300 underline cursor-pointer" data-cmd="open blog">open blog</span> to visit.</span>`
          );
          if (shouldGo) window.location.href = "/blog";
          return;
        }

        // cd projects
        if (normalized === "projects") {
          cwd = "~/projects";
          updatePrompt();
          printLine(
            `<span class="text-neutral-400">Switched directory to <span class="text-sky-300">~/projects</span>. ` +
            `Type <span class="cli-cmd-link text-yellow-300 underline cursor-pointer" data-cmd="ls">ls</span> to view projects or ` +
            `<span class="cli-cmd-link text-yellow-300 underline cursor-pointer" data-cmd="open projects">open projects</span> to visit.</span>`
          );
          if (shouldGo) window.location.href = "/projects";
          return;
        }

        // cd tags
        if (normalized === "tags") {
          cwd = "~/tags";
          updatePrompt();
          printLine(
            `<span class="text-neutral-400">Switched directory to <span class="text-sky-300">~/tags</span>. ` +
            `Type <span class="cli-cmd-link text-yellow-300 underline cursor-pointer" data-cmd="ls">ls</span> to view tags.</span>`
          );
          if (shouldGo) window.location.href = "/tags";
          return;
        }

        // Check if user is trying to cd into a post
        const matchingPost = cliData.blog.find(
          (p) => p.id === normalized || `${p.id}.md` === normalized
        );
        if (matchingPost) {
          printLine(
            `<span class="text-yellow-300">'${escapeHtml(normalized)}' is an article, not a directory.</span><br/>` +
            `Type <span class="cli-cmd-link text-emerald-400 underline cursor-pointer" data-cmd="cat ${matchingPost.id}">cat ${matchingPost.id}</span> to read preview, or ` +
            `<span class="cli-cmd-link text-emerald-400 underline cursor-pointer" data-cmd="open ${matchingPost.id}">open ${matchingPost.id}</span> to navigate to it.`
          );
          return;
        }

        // Check if user is trying to cd into a file
        if (virtualFiles[normalized]) {
          printLine(
            `<span class="text-yellow-300">'${escapeHtml(normalized)}' is a text file.</span> ` +
            `Use <span class="cli-cmd-link text-emerald-400 underline cursor-pointer" data-cmd="cat ${normalized}">cat ${normalized}</span> to view its content.`
          );
          return;
        }

        printLine(`cd: no such file or directory: ${escapeHtml(target)}`, true);
