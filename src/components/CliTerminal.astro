    // Prevent duplicate initializations across view transitions
    if (window.__CLI_INITIALIZED__) return;
    window.__CLI_INITIALIZED__ = true;

    // Load data from JSON tag
    let cliData = { blog: [], projects: [], tags: [], site: {}, socials: [] };
    try {
      const dataScript = document.getElementById("cli-data-source");
      if (dataScript && dataScript.textContent) {
        cliData = JSON.parse(dataScript.textContent);
      }
    } catch (e) {
      console.error("Failed to parse CLI data:", e);
    }

    // CLI Internal State
    let cwd = "~"; // '~', '~/blog', '~/projects', '~/tags'
    const commandHistory = [];
    let historyIndex = -1;
    let tempDraftInput = "";
    let isMaximized = false;
    let hasShownWelcome = false;

    // Virtual Text Files
    const virtualFiles = {
      "about.txt": `NAME: ณวสันต์ (Nawasan)
