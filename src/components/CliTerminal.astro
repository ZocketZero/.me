        let out =
`<div class="space-y-1">
  <div class="text-yellow-300 font-bold">SOCIAL NETWORKS & LINKS:</div>`;
        cliData.socials.forEach((s) => {
          out +=
            `<div class="flex items-center gap-2">` +
            `<span class="text-sky-400 font-semibold">• ${escapeHtml(s.NAME)}:</span> ` +
            `<a href="${s.HREF}" target="_blank" class="text-emerald-400 underline">${escapeHtml(s.HREF)}</a>` +
            `</div>`;
        });
        out +=
          `<div class="flex items-center gap-2">` +
          `<span class="text-sky-400 font-semibold">• Email:</span> ` +
          `<a href="mailto:${cliData.site.EMAIL}" class="text-emerald-400 underline">${cliData.site.EMAIL}</a>` +
          `</div></div>`;
        printLine(out);
      },

      contact: () => {
        commands.cat(["contact.txt"]);
      },

      date: () => {
        const now = new Date();
        printLine(`<span class="text-neutral-200 font-mono">${now.toString()}</span>`);
      },

      ping: (args) => {
        let host = "nawasan.dev";
        let count = 4;

        for (let i = 0; i < args.length; i++) {
          if (args[i] === "-c" && args[i + 1]) {
            count = Math.max(1, Math.min(10, parseInt(args[i + 1], 10) || 4));
            i++;
          } else if (!args[i].startsWith("-")) {
            host = args[i];
          }
        }

        const cleanHost = host.replace(/^https?:\/\//, "").replace(/\/.*$/, "");

        const ipMap = {
          localhost: "127.0.0.1",
          "127.0.0.1": "127.0.0.1",
          "nawasan.dev": "185.199.108.153",
          "www.nawasan.dev": "185.199.108.153",
          "google.com": "142.250.190.46",
          "kali.org": "192.124.249.10",
          "github.com": "140.82.121.4",
        };

        let ip = ipMap[cleanHost.toLowerCase()];
        if (!ip) {
          let hash = 0;
          for (let i = 0; i < cleanHost.length; i++) {
            hash = (hash * 31 + cleanHost.charCodeAt(i)) & 0xffffffff;
          }
          const o1 = 100 + (Math.abs(hash) % 100);
          const o2 = Math.abs(hash >> 8) % 250;
          const o3 = Math.abs(hash >> 16) % 250;
          const o4 = 1 + (Math.abs(hash >> 24) % 254);
          ip = `${o1}.${o2}.${o3}.${o4}`;
        }

        const isLocal = cleanHost === "localhost" || cleanHost === "127.0.0.1";
        const baseLatency = isLocal ? 0.04 : (cleanHost.includes("nawasan.dev") ? 14 : 28);
        const ttl = isLocal ? 64 : 56;

        printLine(`PING ${escapeHtml(cleanHost)} (${ip}): 56 data bytes`);

        const latencies = [];
        let seq = 1;

        if (window.__CLI_PING_INTERVAL__) {
          clearInterval(window.__CLI_PING_INTERVAL__);
          window.__CLI_PING_INTERVAL__ = null;
        }

        window.__CLI_PING_INTERVAL__ = setInterval(() => {
          if (seq > count) {
            clearInterval(window.__CLI_PING_INTERVAL__);
            window.__CLI_PING_INTERVAL__ = null;

            const min = Math.min(...latencies).toFixed(isLocal ? 3 : 1);
            const max = Math.max(...latencies).toFixed(isLocal ? 3 : 1);
            const avg = (latencies.reduce((a, b) => a + b, 0) / latencies.length).toFixed(isLocal ? 3 : 1);

            const stats =
`<div class="mt-1 text-xs">
  <div class="text-neutral-400">--- ${escapeHtml(cleanHost)} ping statistics ---</div>
  <div>${count} packets transmitted, ${count} packets received, <span class="text-emerald-400">0.0% packet loss</span></div>
  <div>round-trip min/avg/max = <span class="text-yellow-300">${min}</span>/<span class="text-yellow-300">${avg}</span>/<span class="text-yellow-300">${max}</span> ms</div>
</div>`;
            printLine(stats);
            return;
          }

          const jitter = (Math.random() * 3.0 - 1.5);
          const lat = isLocal
            ? parseFloat((baseLatency + Math.random() * 0.012).toFixed(3))
            : parseFloat(Math.max(1, baseLatency + jitter).toFixed(1));
          latencies.push(lat);

          printLine(
            `64 bytes from ${ip}: icmp_seq=${seq} ttl=${ttl} time=${lat} ms`
          );

          seq++;
        }, 350);
      },

      clear: () => {
        const output = document.getElementById("cli-output");
        if (output) output.innerHTML = "";
      },

      cls: () => {
        commands.clear();
      },

      history: () => {
        if (commandHistory.length === 0) {
          printLine(`<span class="text-neutral-400">No commands in history.</span>`);
          return;
        }
        let out = `<div class="space-y-0.5 text-neutral-300"><div class="text-yellow-300 font-bold">COMMAND HISTORY:</div>`;
        commandHistory.forEach((cmd, idx) => {
          out += `<div><span class="text-neutral-500 w-6 inline-block">${idx + 1}</span> <span class="cli-cmd-link text-emerald-300 cursor-pointer underline" data-cmd="${escapeHtml(cmd)}">${escapeHtml(cmd)}</span></div>`;
        });
        out += `</div>`;
        printLine(out);
      },

      echo: (args) => {
        printLine(`<span class="text-neutral-200">${escapeHtml(args.join(" "))}</span>`);
      },

      exit: () => {
        closeCli();
      },

      quit: () => {
        closeCli();
      },

      matrix: () => {
        printLine(`<span class="text-emerald-400 font-bold">Wake up, Neo... The Matrix has you.</span>`);
        const characters = "01アイウエオカキクケコサシスセソタチツテト0123456789";
        for (let i = 0; i < 6; i++) {
          setTimeout(() => {
            let row = "";
            for (let j = 0; j < 40; j++) {
              row += characters.charAt(Math.floor(Math.random() * characters.length)) + " ";
            }
            printLine(`<span class="text-emerald-500 text-xs font-mono select-none">${row}</span>`);
          }, i * 150);
        }
      },

      cowsay: (args) => {
        const msg = args.length > 0 ? args.join(" ") : "Welcome to Nawasan's Website!";
        const cow =
` -----------------------------
&lt; ${escapeHtml(msg)} &gt;
 -----------------------------
        \\   ^__^
         \\  (oo)\\_______
            (__)\\       )\\/\\
                ||----w |
                ||     ||`;
        printLine(`<pre class="text-yellow-200 font-mono text-xs">${cow}</pre>`);
      },

      fortune: () => {
        const quotes = [
          "There is no place like ~/",
          "The quieter you become, the more you are able to hear. (Kali Linux motto)",
          "Real programmers count from 0.",
          "It compiles! Ship it to production on Friday at 5 PM.",
          "In a world without fences and walls, who needs Gates and Windows?",
          "Simplicity is prerequisite for reliability. - Edsger W. Dijkstra",
          "There are 10 types of people in the world: those who understand binary, and those who don't."
        ];
        const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
        printLine(`<div class="border-l-2 border-yellow-400 pl-2 text-yellow-200 italic font-mono">"${randomQuote}"</div>`);
      },

      sudo: (args) => {
        const attempted = args.length > 0 ? args.join(" ") : "command";
        printLine(
          `<span class="text-red-400 font-bold">[sudo] password for guest:</span><br/>` +
          `<span class="text-red-400 font-bold">Permission denied:</span> cannot execute '${escapeHtml(attempted)}'. ` +
          `guest is not in the sudoers file. This incident will be reported to the Cybermaster.`,
          true
        );
      }
    };

    const commandHelpDetails = {
      cd: `<div class="text-neutral-300"><span class="text-yellow-300 font-bold">cd &lt;dir&gt;</span>: Changes virtual directory. Use 'cd blog', 'cd projects', 'cd tags', 'cd ~', or 'cd ..'. Add '-g' flag to navigate in browser.</div>`,
      ls: `<div class="text-neutral-300"><span class="text-yellow-300 font-bold">ls [-l] [dir]</span>: Lists files and subfolders in current or specified folder.</div>`,
      cat: `<div class="text-neutral-300"><span class="text-yellow-300 font-bold">cat &lt;file&gt;</span>: Shows the preview or content of any text file, blog post, or project.</div>`,
      open: `<div class="text-neutral-300"><span class="text-yellow-300 font-bold">open &lt;target&gt;</span>: Navigates the browser to a page (home, blog, projects, tags, post id, or project id).</div>`,
      ping: `<div class="text-neutral-300"><span class="text-yellow-300 font-bold">ping &lt;host&gt; [-c count]</span>: Tests network round-trip latency by sending ICMP ECHO_REQUEST packets. Defaults to nawasan.dev.</div>`,
      theme: `<div class="text-neutral-300"><span class="text-yellow-300 font-bold">theme &lt;light|dark|system|toggle&gt;</span>: Changes or toggles website appearance.</div>`
    };

    // Execute input command
    function executeCommand(rawInput) {
      const trimmed = rawInput.trim();
      if (!trimmed) {
        printLine(
          `<div class="flex items-center gap-1.5 text-neutral-400 select-none">` +
          `<span class="text-emerald-400 font-bold">nawasan@cyberhome:</span>` +
          `<span class="text-sky-400">${escapeHtml(cwd)}</span>$&nbsp;` +
          `</div>`
        );
        return;
      }

      printCommandHeader(trimmed);
      commandHistory.push(trimmed);
      historyIndex = commandHistory.length;

      const tokens = trimmed.split(/\s+/);
      const cmd = tokens[0].toLowerCase();
      const args = tokens.slice(1);

      if (commands[cmd]) {
        try {
          commands[cmd](args);
        } catch (err) {
          printLine(`Execution error: ${err.message}`, true);
        }
      } else {
        printLine(
          `Command not found: '${escapeHtml(cmd)}'. Type <span class="cli-cmd-link text-yellow-300 underline cursor-pointer" data-cmd="help">help</span> for a list of valid commands.`,
          true
        );
      }
    }

    // Auto-complete (Tab) logic
    function handleAutocomplete(inputEl) {
      const currentVal = inputEl.value;
      const cursor = inputEl.selectionStart;
      const beforeCursor = currentVal.slice(0, cursor);

      const parts = beforeCursor.trimStart().split(/\s+/);
      const isCommand = parts.length <= 1;

      const allCommandNames = Object.keys(commands);

      if (isCommand) {
        const prefix = parts[0]?.toLowerCase() || "";
        const matches = allCommandNames.filter((c) => c.startsWith(prefix));

        if (matches.length === 1) {
          inputEl.value = matches[0] + " ";
          inputEl.setSelectionRange(inputEl.value.length, inputEl.value.length);
        } else if (matches.length > 1) {
          printCommandHeader(currentVal);
          printLine(`<div class="text-neutral-400 text-xs">${matches.join("    ")}</div>`);
        }
        return;
      }

      // Autocomplete arguments
      const cmd = parts[0].toLowerCase();
      const argPrefix = parts[parts.length - 1]?.toLowerCase() || "";

      let candidateOptions = [];

      if (cmd === "cd") {
        candidateOptions = ["~", "blog", "projects", "tags", ".."];
      } else if (cmd === "cat" || cmd === "show" || cmd === "view") {
        if (cwd === "~") {
          candidateOptions = [
            "about.txt", "contact.txt", "skills.txt", "readme.txt",
            ...cliData.blog.map((b) => b.id),
            ...cliData.projects.map((p) => p.id)
          ];
        } else if (cwd === "~/blog") {
          candidateOptions = cliData.blog.map((b) => b.id);
        } else if (cwd === "~/projects") {
          candidateOptions = cliData.projects.map((p) => p.id);
        }
      } else if (cmd === "open" || cmd === "goto" || cmd === "navigate") {
        candidateOptions = [
          "home", "blog", "projects", "tags", "rss", "github", "linkedin",
          ...cliData.blog.map((b) => b.id),
          ...cliData.projects.map((p) => p.id)
        ];
      } else if (cmd === "theme") {
        candidateOptions = ["light", "dark", "system", "toggle"];
      } else if (cmd === "ping") {
        candidateOptions = ["nawasan.dev", "localhost", "127.0.0.1", "google.com", "kali.org", "github.com"];
      }

      const matches = candidateOptions.filter((opt) => opt.toLowerCase().startsWith(argPrefix));

      if (matches.length === 1) {
        parts[parts.length - 1] = matches[0];
        inputEl.value = parts.join(" ") + " ";
        inputEl.setSelectionRange(inputEl.value.length, inputEl.value.length);
      } else if (matches.length > 1) {
        printCommandHeader(currentVal);
        printLine(`<div class="text-neutral-400 text-xs">${matches.join("    ")}</div>`);
      }
    }

    // Event Listeners: Click delegation for all trigger buttons & links
    document.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      // Trigger buttons
      if (
        target.closest("#cli-trigger-btn") ||
        target.closest("#status-terminal-btn") ||
        target.closest("#menu-terminal-btn") ||
        target.closest("#cli-restore-btn")
      ) {
        e.preventDefault();
        openCli();
        return;
      }

      // Close button
      if (target.closest("#cli-close-btn")) {
        e.preventDefault();
        closeCli();
        return;
      }

      // Minimize button
      if (target.closest("#cli-min-btn")) {
        e.preventDefault();
        minimizeCli();
        return;
      }

      // Maximize button
      if (target.closest("#cli-max-btn")) {
        e.preventDefault();
        toggleMaximizeCli();
        return;
      }

      // Backdrop click closes
      const backdrop = document.getElementById("cli-backdrop");
      if (backdrop && target === backdrop) {
        closeCli();
        return;
      }

      // Quick toolbar buttons or in-terminal clickable command links
      const cmdBtn = target.closest(".cli-cmd-link, .cli-quick-btn");
      if (cmdBtn) {
        const cmdToRun = cmdBtn.getAttribute("data-cmd");
        if (cmdToRun) {
          const input = document.getElementById("cli-input");
          if (input) input.value = cmdToRun;
          executeCommand(cmdToRun);
          if (input) input.value = "";
          const screen = document.getElementById("cli-screen");
          if (screen) screen.scrollTop = screen.scrollHeight;
          input?.focus();
        }
        return;
      }

      // Clicking anywhere on terminal screen focuses input
      if (target.closest("#cli-screen") && !target.closest("button, a")) {
        document.getElementById("cli-input")?.focus();
      }
    });

    // Keyboard Shortcuts & Input Navigation
    document.addEventListener("keydown", (e) => {
      const modal = document.getElementById("cli-modal");
      const isCliOpen = modal && !modal.classList.contains("hidden");

      const activeEl = document.activeElement;
      const isGeneralInput =
        activeEl instanceof HTMLInputElement ||
        activeEl instanceof HTMLTextAreaElement ||
        (activeEl instanceof HTMLElement && activeEl.isContentEditable);

      const isCliInput = activeEl && activeEl.id === "cli-input";

      // Global hotkey: ` (backtick) or Ctrl+` or ~ to toggle CLI
      if (
        (e.key === "`" && !isGeneralInput) ||
        ((e.ctrlKey || e.metaKey) && e.key === "`") ||
        (e.key === "~" && !isGeneralInput)
      ) {
        e.preventDefault();
        if (isCliOpen) {
          closeCli();
        } else {
          openCli();
        }
        return;
      }

      // Escape key closes modal if open
      if (e.key === "Escape" && isCliOpen) {
        e.preventDefault();
        closeCli();
        return;
      }

      // Handle CLI input key actions
      if (isCliOpen && isCliInput) {
        const input = document.getElementById("cli-input");
        if (!input) return;

        if (e.key === "Enter") {
          e.preventDefault();
          const val = input.value;
          input.value = "";
          executeCommand(val);
        } else if (e.key === "Tab") {
          e.preventDefault();
          handleAutocomplete(input);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          if (commandHistory.length === 0) return;
          if (historyIndex === commandHistory.length) {
            tempDraftInput = input.value;
          }
          if (historyIndex > 0) {
            historyIndex--;
            input.value = commandHistory[historyIndex];
            input.setSelectionRange(input.value.length, input.value.length);
          }
        } else if (e.key === "ArrowDown") {
          e.preventDefault();
          if (commandHistory.length === 0) return;
          if (historyIndex < commandHistory.length - 1) {
            historyIndex++;
            input.value = commandHistory[historyIndex];
            input.setSelectionRange(input.value.length, input.value.length);
          } else if (historyIndex === commandHistory.length - 1) {
            historyIndex = commandHistory.length;
            input.value = tempDraftInput;
            input.setSelectionRange(input.value.length, input.value.length);
          }
        } else if (e.ctrlKey && e.key.toLowerCase() === "l") {
          // Ctrl+L clears output
          e.preventDefault();
          commands.clear();
        } else if (e.ctrlKey && e.key.toLowerCase() === "c") {
          // Ctrl+C cancels current line or active process
          e.preventDefault();
          if (window.__CLI_PING_INTERVAL__) {
            clearInterval(window.__CLI_PING_INTERVAL__);
            window.__CLI_PING_INTERVAL__ = null;
            printLine(`<span class="text-neutral-400">--- ping aborted by user (^C) ---</span>`);
          }
          printCommandHeader(input.value + "^C");
          input.value = "";
        }
      }
    });

    // Make window draggable via titlebar
    (function makeDraggable() {
      const titlebar = document.getElementById("cli-titlebar");
      const win = document.getElementById("cli-window");
      if (!titlebar || !win) return;

      let isDragging = false;
      let startX = 0, startY = 0;
      let initialLeft = 0, initialTop = 0;

      titlebar.addEventListener("mousedown", (e) => {
        if (isMaximized) return;
        if (e.target.closest("button")) return;

        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;

        const rect = win.getBoundingClientRect();
        initialLeft = rect.left;
        initialTop = rect.top;

        win.style.position = "fixed";
        win.style.left = `${initialLeft}px`;
        win.style.top = `${initialTop}px`;
        win.style.margin = "0";

        document.addEventListener("mousemove", onMouseMove);
        document.addEventListener("mouseup", onMouseUp);
      });

      function onMouseMove(e) {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        win.style.left = `${Math.max(10, Math.min(window.innerWidth - 100, initialLeft + dx))}px`;
        win.style.top = `${Math.max(10, Math.min(window.innerHeight - 80, initialTop + dy))}px`;
      }

      function onMouseUp() {
        isDragging = false;
        document.removeEventListener("mousemove", onMouseMove);
        document.removeEventListener("mouseup", onMouseUp);
      }
    })();
  })();
</script>

