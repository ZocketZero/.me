---
import { getCollection } from "astro:content";
import { SITE, SOCIALS } from "@consts";
import { readingTime } from "@lib/utils";

const blogPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    date: post.data.date.toISOString().split("T")[0],
    tags: post.data.tags || [],
    readingTime: post.body ? readingTime(post.body) : "1 min read",
    url: `/blog/${post.id}`,
  }));

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    description: p.data.description,
    date: p.data.date.toISOString().split("T")[0],
    demoURL: p.data.demoURL || null,
    repoURL: p.data.repoURL || null,
    url: `/projects/${p.id}`,
  }));

const tagMap: Record<string, number> = {};
for (const post of blogPosts) {
  for (const tag of post.tags) {
    tagMap[tag] = (tagMap[tag] || 0) + 1;
  }
}

const tags = Object.entries(tagMap).map(([tag, count]) => ({
  name: tag,
  count,
  url: `/tags/${tag}`,
}));

const cliPayload = {
  blog: blogPosts,
  projects,
  tags,
  site: SITE,
  socials: SOCIALS,
};
---

<!-- CLI Modal Container with Astro View Transitions Persistence -->
<aside id="cli-modal" transition:persist class="hidden" data-pagefind-ignore>
  <div
    id="cli-backdrop"
    class="fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-black/65 backdrop-blur-xs select-none"
  >
    <div
      id="cli-window"
      class="retro-window w-full max-w-3xl flex flex-col shadow-2xl overflow-hidden h-[82vh] max-h-[660px]"
    >
      <!-- Titlebar -->
      <div
        id="cli-titlebar"
        class="retro-titlebar px-2.5 py-1 text-xs sm:text-sm font-bold flex items-center justify-between select-none border-b border-[#404040]"
      >
        <div class="flex items-center gap-2 truncate">
          <span class="text-sm">📟</span>
          <span class="truncate font-mono">MS-DOS Prompt - nawasan@cyberhome: <span id="cli-title-path">~</span> (sh)</span>
        </div>
        <div class="flex items-center gap-1 shrink-0 ml-2">
          <button id="cli-min-btn" class="retro-win-ctrl-btn" title="Minimize to dock" aria-label="Minimize">_</button>
          <button id="cli-max-btn" class="retro-win-ctrl-btn" title="Toggle Maximize" aria-label="Maximize">□</button>
          <button id="cli-close-btn" class="retro-win-ctrl-btn retro-win-ctrl-close" title="Close Terminal (Esc)" aria-label="Close">✕</button>
        </div>
      </div>

      <!-- Quick Toolbar -->
      <div class="flex items-center justify-between px-2 py-1 text-[11px] bg-[#d4d0c8] dark:bg-[#1a2234] border-b border-[#808080] font-retro text-neutral-700 dark:text-neutral-300">
        <div class="flex items-center gap-2">
          <span class="font-bold text-[#0a246a] dark:text-[#38bdf8]">SESSION:</span>
          <span class="font-mono">guest@cyberhome</span>
          <span class="text-neutral-400">|</span>
          <span class="hidden sm:inline font-mono">VT100 80x25</span>
        </div>
        <div class="flex items-center gap-1">
          <button class="cli-quick-btn retro-btn text-[10px] py-0 px-1.5" data-cmd="help">help</button>
          <button class="cli-quick-btn retro-btn text-[10px] py-0 px-1.5" data-cmd="ls">ls</button>
          <button class="cli-quick-btn retro-btn text-[10px] py-0 px-1.5" data-cmd="tree">tree</button>
          <button class="cli-quick-btn retro-btn text-[10px] py-0 px-1.5" data-cmd="neofetch">fetch</button>
          <button class="cli-quick-btn retro-btn text-[10px] py-0 px-1.5" data-cmd="clear">clear</button>
        </div>
      </div>

      <!-- Terminal Body / Output & Prompt Screen -->
      <div
        id="cli-screen"
        class="flex-1 bg-[#0b1017] text-[#e2e8f0] p-3 sm:p-4 font-mono text-xs sm:text-sm overflow-y-auto leading-relaxed retro-bevel-inset focus:outline-none select-text"
        tabindex="0"
      >
        <!-- Dynamic terminal log lines will be appended here -->
        <div id="cli-output" class="space-y-2"></div>

        <!-- Active Input Line -->
        <div id="cli-input-line" class="flex items-center gap-1.5 mt-2">
          <span id="cli-prompt-label" class="font-bold text-emerald-400 shrink-0 select-none">
            nawasan@cyberhome:<span class="text-sky-400">~</span>$&nbsp;
          </span>
          <input
            id="cli-input"
            type="text"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            class="flex-1 bg-transparent border-none outline-none text-[#00ff66] font-mono text-xs sm:text-sm p-0 m-0 caret-[#00ff66]"
          />
        </div>
      </div>

      <!-- Terminal Status / Bottom Helper Bar -->
      <div class="flex items-center justify-between px-2 py-1 text-[11px] font-mono bg-[#d4d0c8] dark:bg-[#1a2234] border-t border-[#808080] text-neutral-700 dark:text-neutral-300 select-none">
        <div class="flex items-center gap-2 truncate">
          <span class="retro-bevel-inset px-1 py-0.2 bg-white/60 dark:bg-black/30 text-[10px] font-bold">READY</span>
          <span class="hidden md:inline text-neutral-600 dark:text-neutral-400">
            [Tab] Autocomplete • [↑↓] History • [Ctrl+L] Clear • 'help' for manual
          </span>
          <span class="md:hidden text-neutral-600 dark:text-neutral-400">
            [Tab] Complete • 'help'
          </span>
        </div>
        <div class="shrink-0 flex items-center gap-1">
          <span class="retro-bevel-inset px-1 py-0.2 bg-white/60 dark:bg-black/30 text-emerald-700 dark:text-emerald-400 font-bold text-[10px]">
            ● ONLINE
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Minimized Floating Dock Button -->
  <div
    id="cli-minimized-dock"
    class="fixed bottom-3 right-3 z-50 hidden"
  >
    <button
      id="cli-restore-btn"
      class="retro-btn flex items-center gap-2 px-3 py-1.5 shadow-2xl font-mono text-xs bg-[#ece9d8] dark:bg-[#1a2336] border-2 border-emerald-500 font-bold"
      title="Restore CLI Terminal"
    >
      <span class="text-emerald-600 dark:text-emerald-400 font-bold text-sm">&gt;_</span>
      <span>Terminal [Minimized]</span>
      <span class="text-[10px] text-neutral-500 hidden sm:inline">(Click to restore)</span>
    </button>
  </div>
</aside>

<!-- Embedded Data Payload for Client Terminal Script -->
<script id="cli-data-source" type="application/json" set:html={JSON.stringify(cliPayload)} />

<script is:inline>
