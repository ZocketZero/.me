      theme: (args) => {
        const currentTheme = localStorage.getItem("theme") || "system";
        const isDarkNow = document.documentElement.classList.contains("dark");
        const mode = args[0]?.toLowerCase();

        if (!mode) {
          printLine(
            `<span class="text-neutral-300">Current theme setting: <span class="text-yellow-300 font-bold">${currentTheme}</span> ` +
            `(Active display: <span class="text-sky-300 font-bold">${isDarkNow ? "Dark / Y2K Cyber" : "Light / Classic 2000"}</span>)</span><br/>` +
            `<span class="text-neutral-400 text-xs">Usage: theme [light | dark | system | toggle]</span>`
          );
          return;
        }

        let newTheme = currentTheme;
        if (mode === "toggle") {
          newTheme = isDarkNow ? "light" : "dark";
        } else if (mode === "light" || mode === "dark" || mode === "system") {
          newTheme = mode;
        } else {
          printLine(`theme: unknown mode '${escapeHtml(mode)}'. Choose from: light, dark, system, toggle`, true);
          return;
        }

        localStorage.setItem("theme", newTheme);
        const shouldBeDark =
          newTheme === "dark" ||
          (newTheme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);

        document.documentElement.classList.toggle("dark", shouldBeDark);

        // Update footer buttons if present
        const lightBtn = document.getElementById("light-theme-button");
        const darkBtn = document.getElementById("dark-theme-button");
        const systemBtn = document.getElementById("system-theme-button");
        const updateBtn = (btn, active) => {
          if (!btn) return;
          btn.classList.toggle("active", active);
        };
        updateBtn(lightBtn, newTheme === "light");
        updateBtn(darkBtn, newTheme === "dark");
        updateBtn(systemBtn, newTheme === "system");

        printLine(
          `<span class="text-emerald-400">✓ Theme changed to <span class="font-bold">${newTheme}</span> ` +
          `(${shouldBeDark ? "Y2K Cyber Night" : "Classic 2000 Teal/Grey"})</span>`
        );
      },

