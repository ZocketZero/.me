    };

    // Helper: Escape HTML
    function escapeHtml(str) {
      if (!str) return "";
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    // Modal Control Functions
    function openCli() {
      const modal = document.getElementById("cli-modal");
      const dock = document.getElementById("cli-minimized-dock");
      const input = document.getElementById("cli-input");
      const screen = document.getElementById("cli-screen");

      if (!modal) return;
      modal.classList.remove("hidden");
      if (dock) dock.classList.add("hidden");

      if (!hasShownWelcome) {
        showWelcomeMessage();
        hasShownWelcome = true;
      }

      setTimeout(() => {
        input?.focus();
        if (screen) screen.scrollTop = screen.scrollHeight;
      }, 50);
    }

    function closeCli() {
      const modal = document.getElementById("cli-modal");
      const dock = document.getElementById("cli-minimized-dock");
      if (modal) modal.classList.add("hidden");
      if (dock) dock.classList.add("hidden");
    }

    function minimizeCli() {
      const modal = document.getElementById("cli-modal");
      const dock = document.getElementById("cli-minimized-dock");
      if (modal) modal.classList.add("hidden");
      if (dock) dock.classList.remove("hidden");
    }

    function toggleMaximizeCli() {
      const win = document.getElementById("cli-window");
      if (!win) return;
      isMaximized = !isMaximized;
      if (isMaximized) {
        win.classList.remove("max-w-3xl", "h-[82vh]", "max-h-[660px]");
        win.classList.add("w-full", "h-full", "max-w-none", "max-h-none", "m-0");
      } else {
        win.classList.add("max-w-3xl", "h-[82vh]", "max-h-[660px]");
        win.classList.remove("w-full", "h-full", "max-w-none", "max-h-none", "m-0");
      }
    }

    function updatePrompt() {
      const promptLabel = document.getElementById("cli-prompt-label");
      const titlePath = document.getElementById("cli-title-path");

      if (promptLabel) {
        promptLabel.innerHTML = `nawasan@cyberhome:<span class="text-sky-400">${escapeHtml(cwd)}</span>$&nbsp;`;
      }
      if (titlePath) {
        titlePath.textContent = cwd;
      }
    }

    function printLine(htmlContent, isError = false) {
      const output = document.getElementById("cli-output");
      const screen = document.getElementById("cli-screen");
      if (!output) return;

      const lineDiv = document.createElement("div");
      lineDiv.className = isError ? "text-red-400 font-mono" : "font-mono";
      lineDiv.innerHTML = htmlContent;
      output.appendChild(lineDiv);

      if (screen) {
        screen.scrollTop = screen.scrollHeight;
      }
    }

    function printCommandHeader(commandText) {
      const promptPath = cwd;
      printLine(
        `<div class="flex items-center gap-1.5 text-neutral-400 select-none">` +
        `<span class="text-emerald-400 font-bold">nawasan@cyberhome:</span>` +
        `<span class="text-sky-400">${escapeHtml(promptPath)}</span>$&nbsp;` +
        `<span class="text-white font-bold">${escapeHtml(commandText)}</span>` +
        `</div>`
      );
    }

    function showWelcomeMessage() {
      const asciiBanner =
`<span class="text-emerald-400 font-bold">
