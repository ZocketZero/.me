---
import Search from "astro-pagefind/components/Search.astro";
---

<aside id="search-box" transition:persist class="hidden" data-pagefind-ignore>
  <div
    id="backdrop"
    class="bg-[rgba(0,0,0,0.6)] fixed top-0 left-0 z-50 flex h-screen w-full justify-center p-3 sm:p-6"
  >
    <div
      id="pagefind-container"
      class="m-0 flex h-fit max-h-[85%] w-full max-w-lg flex-col overflow-hidden retro-window shadow-2xl"
    >
      <!-- Dialog Titlebar -->
      <div class="retro-titlebar px-2.5 py-1 text-xs sm:text-sm font-bold flex items-center justify-between select-none border-b border-[#404040]">
        <div class="flex items-center gap-2">
          <span>🔍</span>
          <span>Find: All Files, Articles & Topics</span>
        </div>
        <button
          id="close-pagefind-btn"
          aria-label="Close search"
          class="retro-win-ctrl-btn retro-win-ctrl-close"
          title="Close Dialog (Esc)"
        >
          ✕
        </button>
      </div>

      <!-- Dialog Body -->
      <div class="p-3 bg-[#ece9d8] dark:bg-[#151c2c] overflow-y-auto max-h-[75vh]">
        <div class="mb-2 text-xs font-retro text-neutral-600 dark:text-neutral-400">
          Type keywords to search through all indexed articles and software projects:
        </div>

        <div id="search" class="retro-bevel-inset bg-white dark:bg-[#090d16] p-2">
          <Search
            instance="search"
            className="pagefind-ui"
            searchboxOptions={{
              showImages: false,
              excerptLength: 15,
              resetStyles: false,
            }}
          />
        </div>

        <div class="mt-2.5 pt-1.5 border-t border-[#808080] dark:border-[#334155] text-right text-[11px] font-mono text-neutral-500">
          Press <kbd class="px-1 py-0.5 bg-neutral-200 dark:bg-neutral-800 border border-neutral-400">Esc</kbd> or click outside to close
        </div>
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  (function setupPagefind() {
    function openPagefind() {
      const searchBox = document.getElementById("search-box");
      const searchInput = document.querySelector("#search input");
      searchBox?.classList.remove("hidden");
      setTimeout(() => {
        searchInput?.focus();
      }, 50);
    }

    function closePagefind() {
      const searchBox = document.getElementById("search-box");
      const searchInput = document.querySelector("#search input");
      if (searchInput) searchInput.value = "";
      searchBox?.classList.add("hidden");
    }

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest("#magnifying-glass")) {
        openPagefind();
        return;
      }

      if (target.closest("#close-pagefind-btn")) {
        closePagefind();
        return;
      }

      if (target.classList.contains("pagefind-ui__result-link")) {
        closePagefind();
        return;
      }

      const backdrop = document.getElementById("backdrop");
      if (backdrop && target === backdrop) {
        closePagefind();
      }
    });

    document.addEventListener("keydown", (e) => {
      const activeEl = document.activeElement;
      const isInput =
        activeEl instanceof HTMLInputElement ||
        activeEl instanceof HTMLTextAreaElement ||
        (activeEl instanceof HTMLElement && activeEl.isContentEditable);

      if (e.key === "Escape") {
        closePagefind();
      } else if (e.key === "/" && !isInput) {
        e.preventDefault();
        openPagefind();
      } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        openPagefind();
      }
    });

    document.addEventListener("submit", (event) => {
      if (event.target instanceof Element && event.target.closest("#search")) {
        event.preventDefault();
      }
    });
  })();
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.8;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0px;
    --pagefind-ui-font: "MS Sans Serif", Tahoma, Verdana, sans-serif;
    --pagefind-ui-primary: #0a246a;
    --pagefind-ui-text: #1a1a1a;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #808080;
    --pagefind-ui-tag: #ece9d8;
  }

  .dark {
    --pagefind-ui-primary: #38bdf8;
    --pagefind-ui-text: #e2e8f0;
    --pagefind-ui-background: #090d16;
    --pagefind-ui-border: #334155;
    --pagefind-ui-tag: #1e293b;
  }

  #search input {
    font-weight: normal;
    border: 2px inset #808080 !important;
    background: #ffffff !important;
    color: #000000 !important;
    border-radius: 0 !important;
    padding: 6px !important;
    font-family: "MS Sans Serif", Tahoma, Verdana, sans-serif !important;
  }

  .dark #search input {
    background: #090d16 !important;
    color: #e2e8f0 !important;
    border-color: #334155 !important;
  }

  #search p {
    font-weight: normal;
  }

  #search .pagefind-ui__result-title {
    font-weight: 700;
    color: #0000cc !important;
    text-decoration: underline;
  }

  .dark #search .pagefind-ui__result-title {
    color: #38bdf8 !important;
  }

  #search .pagefind-ui__result-link {
    text-decoration: underline;
  }

  #search .pagefind-ui__message {
    padding: 0;
    padding-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>
