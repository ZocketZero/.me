---
import Search from "astro-pagefind/components/Search.astro";
---

<aside id="search-box" transition:persist class="hidden" data-pagefind-ignore>
  <div
    id="backdrop"
    class="bg-[rgba(0, 0, 0, 0.5)] fixed top-0 left-0 z-50 flex h-screen w-full justify-center p-6 backdrop-blur-xs"
  >
    <div
      id="pagefind-container"
      class="m-0 flex h-fit max-h-[80%] w-full max-w-(--breakpoint-sm) flex-col overflow-visible rounded-sm border border-black/15 bg-neutral-100 p-2 px-4 py-3 shadow-lg dark:border-white/20 dark:bg-neutral-900"
    >
      <div id="search">
        <Search
          instance="search"
          className="pagefind-ui"
          searchboxOptions={{
            showImages: false,
            excerptLength: 15,
            resetStyles: false,
          }}
        />
      </div>
      <div class="dark:prose-invert mr-2 pt-4 pb-1 text-right text-xs">
        Press <span class="prose dark:prose-invert text-xs"
          ><kbd class="">Esc</kbd></span
        > or click anywhere to close
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  (function setupPagefind() {
    function openPagefind() {
      const searchBox = document.getElementById("search-box");
      const searchInput = document.querySelector("#search input");
      searchBox?.classList.remove("hidden");
      setTimeout(() => {
        searchInput?.focus();
      }, 50);
    }

    function closePagefind() {
      const searchBox = document.getElementById("search-box");
      const searchInput = document.querySelector("#search input");
      if (searchInput) searchInput.value = "";
      searchBox?.classList.add("hidden");
    }

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest("#magnifying-glass")) {
        openPagefind();
        return;
      }

      if (target.classList.contains("pagefind-ui__result-link")) {
        closePagefind();
        return;
      }

      const backdrop = document.getElementById("backdrop");
      if (backdrop && target === backdrop) {
        closePagefind();
      }
    });

    document.addEventListener("keydown", (e) => {
      const activeEl = document.activeElement;
      const isInput =
        activeEl instanceof HTMLInputElement ||
        activeEl instanceof HTMLTextAreaElement ||
        (activeEl instanceof HTMLElement && activeEl.isContentEditable);

      if (e.key === "Escape") {
        closePagefind();
      } else if (e.key === "/" && !isInput) {
        e.preventDefault();
        openPagefind();
      } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        openPagefind();
      }
    });

    document.addEventListener("submit", (event) => {
      if (event.target instanceof Element && event.target.closest("#search")) {
        event.preventDefault();
      }
    });
  })();
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.75;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 3px;
    --pagefind-ui-font: "Geist", sans-serif;
    --pagefind-ui-primary: #3d3d3d;
    --pagefind-ui-text: #3d3d3d;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #d0d0d0;
    --pagefind-ui-tag: #f5f5f5;
  }

  .dark {
    --pagefind-ui-primary: #d4d4d4;
    --pagefind-ui-text: #d4d4d4;
    --pagefind-ui-background: #171717;
    --pagefind-ui-border: #404040;
  }

  #search input {
    font-weight: normal;
  }

  #search p {
    font-weight: normal;
  }

  #search .pagefind-ui__result-title {
    font-weight: 600;
  }

  #search .pagefind-ui__message {
    padding: 0;
    padding-bottom: 0.75rem;
  }
</style>
