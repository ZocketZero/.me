---
const { prevPost, nextPost } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 select-none">
  {
    prevPost?.id ? (
      <a
        href={`/blog/${prevPost?.id}`}
        class="retro-bevel bg-[#e4e0d8] dark:bg-[#1e293b] hover:bg-[#ffffe0] dark:hover:bg-[#27354f] p-2.5 flex items-center gap-2 no-underline text-xs sm:text-sm font-heading"
      >
        <span class="text-base">◀</span>
        <div class="truncate">
          <div class="text-[10px] font-mono text-neutral-500 uppercase font-bold">Previous Article</div>
          <div class="font-bold text-[#0000cc] dark:text-[#38bdf8] truncate">{prevPost?.data.title}</div>
        </div>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )
  }

  {
    nextPost?.id ? (
      <a
        href={`/blog/${nextPost?.id}`}
        class="retro-bevel bg-[#e4e0d8] dark:bg-[#1e293b] hover:bg-[#ffffe0] dark:hover:bg-[#27354f] p-2.5 flex items-center justify-end gap-2 text-right no-underline text-xs sm:text-sm font-heading"
      >
        <div class="truncate">
          <div class="text-[10px] font-mono text-neutral-500 uppercase font-bold">Next Article</div>
          <div class="font-bold text-[#0000cc] dark:text-[#38bdf8] truncate">{nextPost?.data.title}</div>
        </div>
        <span class="text-base">▶</span>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )
  }
</div>
