---
interface Props {
  type?: "default" | "info" | "warning" | "error";
}
const { type = "default" } = Astro.props;
let emoji = "💡";
let title = "Tip / Note";
if (type === "info") {
  emoji = "ℹ️";
  title = "System Information";
} else if (type === "warning") {
  emoji = "⚠️";
  title = "Warning Alert";
} else if (type === "error") {
  emoji = "🚨";
  title = "Critical Message";
}
---

<div class="not-prose retro-bevel bg-[#ece9d8] dark:bg-[#1a2336] p-1.5 my-4 text-xs sm:text-sm font-retro">
  <!-- Titlebar -->
  <div class="retro-sub-titlebar px-2 py-0.5 font-bold flex items-center justify-between text-xs select-none">
    <div class="flex items-center gap-1.5">
      <span>{emoji}</span>
      <span>{title}</span>
    </div>
    <span class="retro-win-ctrl-btn text-[10px]">✕</span>
  </div>

  <!-- Content with Dialog Icon and OK Button -->
  <div class="retro-bevel-inset bg-white dark:bg-[#090d16] p-3 mt-1 flex flex-col sm:flex-row items-start gap-3">
    <div class="text-2xl select-none shrink-0">{emoji}</div>
    <div class="flex-1 font-retro leading-relaxed text-neutral-800 dark:text-neutral-200">
      <slot />
    </div>
    <div class="shrink-0 self-end sm:self-center">
      <button class="retro-btn text-xs py-0.5 px-3 font-bold">OK</button>
    </div>
  </div>
</div>
