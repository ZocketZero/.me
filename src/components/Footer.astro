---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
---

<footer class="border-t-2 border-[#808080] dark:border-[#334155] bg-[#d4d0c8] dark:bg-[#151c2c] p-3 sm:p-5 select-none text-neutral-800 dark:text-neutral-200">
  <Container>
    <div class="flex flex-col items-center gap-5 text-center">

      <!-- The WebRing 2000 Box -->
      <div class="retro-bevel bg-[#ece9d8] dark:bg-[#1e293b] p-2.5 max-w-lg w-full text-xs font-retro">
        <div class="font-bold text-[#0a246a] dark:text-[#38bdf8] border-b border-[#808080] pb-1">
          ~*~ The Open Source & Cyber-Dev WebRing ~*~
        </div>
        <div class="py-1.5 flex items-center justify-center gap-3 font-bold">
          <a href="#webring" class="retro-btn text-xs py-0.5 px-2">&laquo; Prev Site</a>
          <a href="#webring" class="retro-btn text-xs py-0.5 px-2">Next Site &raquo;</a>
        </div>
        <div class="text-[11px] text-neutral-500 dark:text-neutral-400 font-mono">
          Member #042 | Join the Ring by contacting the Webmaster!
        </div>
      </div>

      <hr class="retro-hr w-full max-w-xl" />

      <!-- Controls Row: Theme Buttons & Back to Top -->
      <div class="flex flex-wrap items-center justify-center gap-2">
        <span class="text-xs font-bold mr-1">Display Theme:</span>
        <button
          id="light-theme-button"
          aria-label="Light theme"
          class="retro-btn text-xs"
          title="Classic 2000s Teal & Windows Grey"
        >
          <span>☀️</span>
          <span>Classic 2000</span>
        </button>

        <button
          id="dark-theme-button"
          aria-label="Dark theme"
          class="retro-btn text-xs"
          title="Y2K Cyber Night & Neon"
        >
          <span>🌙</span>
          <span>Y2K Cyber</span>
        </button>

        <button
          id="system-theme-button"
          aria-label="System theme"
          class="retro-btn text-xs"
          title="Match System Settings"
        >
          <span>🖥️</span>
          <span>System</span>
        </button>

        <button
          id="back-to-top"
          aria-label="Back to top"
          class="retro-btn text-xs ml-2 bg-[#ffffe0] dark:bg-[#0f172a]"
          title="Scroll back to top of page"
        >
          <span>▲</span>
          <span>Top</span>
        </button>
      </div>

      <!-- Copyright & System Meta -->
      <div class="text-xs font-retro space-y-1 text-neutral-600 dark:text-neutral-400 border-t border-[#808080] dark:border-[#334155] pt-3 w-full">
        <div>
          &copy; 2001-{new Date().getFullYear()} • <strong>{SITE.TITLE}</strong> </div>
        <div class="font-pixel text-sm">
          Best viewed at 1024x768 in Netscape Navigator or Internet Explorer 5.0+
        </div>
      </div>

    </div>
  </Container>
</footer>
