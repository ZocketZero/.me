---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  group?: boolean;
  class?: string;
};

const {
  href,
  external,
  underline = true,
  group = false,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  rel={external ? "noopener noreferrer" : undefined}
  class={cn(
    "text-[#0000cc] dark:text-[#38bdf8] hover:text-[#ff0000] dark:hover:text-[#00ff66] hover:bg-yellow-200/50 dark:hover:bg-cyan-950/50 font-medium",
    underline ? "underline underline-offset-2" : "no-underline",
    group && "group",
    className,
  )}
  {...rest}
>
  <slot />
</a>
